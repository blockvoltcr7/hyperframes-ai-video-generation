# HyperFrames local generation configuration. Copy to .env and fill in only
# the providers you want to use. Codex authentication comes from the local
# `codex` CLI and does not require an API key here.

# ─── Optional OpenAI API image generation ─────────────────────────────────
# Codex built-in image generation uses your Codex/ChatGPT login and does not
# need this key. These vars are only for the explicit `--api` alternative.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# ─── fal.ai image-to-video (paid, explicit --api path only) ────────────────
# Keep the canonical credential in this ignored repository .env file.
# FAL_AI_API_KEY is preferred; FAL_KEY is the official SDK alias. If more than
# one repository or ambient alias is set, every nonempty value must be exactly
# the same or generation fails closed. Ambient-only credentials are rejected.
# Never pass either value on the command line.
# FAL_AI_API_KEY=
# FAL_KEY=

# ─── Fish Audio TTS (paid API, project-local voice replacement) ───────────
# Keep the canonical credential in the ignored repository `.env` file.
# Project-local generators may accept either alias and must never print it.
# FISH_AUDIO_API_KEY=
# FISH_API_KEY=

# ─── ElevenLabs TTS (required if step 5 of new-archon-short uses ElevenLabs) ─
# All eight required vars must be set or scripts/elevenlabs-tts.py will KeyError.
# TTS scripts load settings from the repository `.env` file.
#
# Preset voice IDs (use one of these in VOICE_ID if not using a clone):
#   Brian   nPczCjzI2devNBz1zQrb  — mature American male, news/launch
#   Adam    pNInz6obpgDQGcFmaJgB  — legacy, deeper American
#   Daniel  onwK4e9ZLuTAKqWW03F9  — British documentary
#
# Tuning matrix — these defaults are the tested-good values for SHORTS on
# an Instant Voice Clone (IVC). Adjust per-knob if symptoms appear:
#
#   STABILITY=0.40
#     - Below 0.30  → phoneme artifacts ("incoherent words" in the output)
#     - Above 0.50  → monotone delivery; loses prosodic range
#     - 0.40 is the artifact-floor that still allows the clone to be expressive
#
#   SIMILARITY_BOOST=0.75 (NOT 0.85, which is ElevenLabs' default)
#     - High values (0.85+) lock the model to the static reference timbre
#       and suppress dynamic prosody. Counter-intuitive but real.
#     - 0.70-0.78 gives the model room to add intonation without drifting
#       too far from the reference voice
#
#   STYLE=0.70  (for shorts; lower for long-form)
#     - Above 0.75 with STABILITY≤0.40 → garbled words return
#     - Below 0.50 → flat reads
#     - 0.65-0.70 is the energy sweet spot for shorts
#
#   SPEED_SHORTS=1.15 (ceiling)
#     - 1.20 compresses phonemes (artifacts) AND flattens sentence-final
#       falling intonation (sentences sound mid-thought)
#     - 1.10-1.15 is the safe range; 1.15 reads with the most energy
#
# MODEL_ID=eleven_multilingual_v2 reads with more expressive range than
#   eleven_turbo_v2_5. Turbo is cheaper + faster but noticeably flatter.
#
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.40
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.70
# ELEVENLABS_SPEED=1.00
# ELEVENLABS_SPEED_SHORTS=1.15
# ELEVENLABS_USE_SPEAKER_BOOST=true
# Optional: pronunciation dictionary (both required if either is set)
# ELEVENLABS_PRONUNCIATION_DICT_ID=
# ELEVENLABS_PRONUNCIATION_DICT_VERSION_ID=

# ─── Kokoro TTS (FREE local alternative — required if step 5 uses Kokoro) ─
# Kokoro is open-weight (Apache-licensed), runs locally on CPU, no API key.
# Quality is comparable to commercial TTS for most narration use cases.
# First run downloads a ~325MB model from Hugging Face; subsequent runs are
# fully offline. Word-level timestamps come back natively (no Whisper pass).
#
# System prerequisite (one-time, not in pip): espeak-ng for phoneme conversion.
#   Linux:    sudo apt install espeak-ng
#   macOS:    brew install espeak
#   Windows:  download the .msi from
#             https://github.com/espeak-ng/espeak-ng/releases
#
# Python deps:  pip install kokoro>=0.9.4 soundfile numpy
#
# Voice catalog (~48 voices, 8 languages). Quality grades A–F per voice.
# American English picks:
#   af_heart    American female (warm, default — grade A)
#   af_nova     American female (brighter)
#   af_bella    American female (deeper)
#   am_michael  American male (mature)
#   am_adam     American male (neutral)
# British English: bf_alice, bm_george, etc.
# Other languages prefix: e_ (Spanish), f_ (French), j_ (Japanese), z_ (Mandarin)…
# See: https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
#
# KOKORO_VOICE=af_heart
# KOKORO_LANG_CODE=a              # 'a'=American Eng, 'b'=British Eng, 'j'=Japanese, etc.
# KOKORO_SPEED=1.00               # long-form default
# KOKORO_SPEED_SHORTS=1.15        # used with --shorts flag (matches ElevenLabs cadence)
